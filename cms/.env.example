DATABASE_URL=postgres://postgres@127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Media storage.
#
# Leave GCS_BUCKET unset for local development: uploads go to cms/media/ on disk,
# which is fine on one machine.
#
# Set it in every deployed environment. Cloud Run's filesystem is ephemeral and
# per-instance, so without a bucket uploads vanish on redeploy, and an image uploaded
# to one instance 404s on another.
#
# GCP_PROJECT_ID is optional on Cloud Run, where the service account is ambient and
# Application Default Credentials resolve it. To test against a real bucket locally,
# also set GOOGLE_APPLICATION_CREDENTIALS to a service-account key file.
# GCS_BUCKET=
# GCP_PROJECT_ID=

---
import type { Page } from "../types/payload";
import Layout from "../layouts/Layout.astro";
import { fetchPages } from "../lib/pages";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";


/**
 * Prerendered. Production is plain HTML on disk: no server to run, and a CMS
 * outage can't take the public site down. Content changes reach the site through
 * a rebuild, not a request.
 *
 * This used to read `import.meta.env.PROD`, on the theory that dev would render
 * on demand and stay live against the CMS. It never did. Astro needs this value
 * to be statically analyzable, and with no adapter configured there is nothing
 * that *could* render on demand — so it silently prerendered in dev too, and
 * getStaticPaths results were cached for the life of the dev server. The result
 * was editors' changes not appearing for days. Stating it plainly is honest about
 * what actually happens.
 */
export const prerender = true;

export async function getStaticPaths() {
  const pages = await fetchPages();
  return pages.map((page) => ({
    params: { slug: page.slug },
    // Pass the page through so the build doesn't refetch the collection per page.
    props: { page },
  }));
}

interface Props {
  /** Supplied by getStaticPaths. Ignored in dev — see below. */
  page?: Page;
}

/**
 * In dev, refetch instead of trusting the prop.
 *
 * Astro caches getStaticPaths for the dev server's lifetime, so the props it
 * carries go stale the moment anyone edits in the CMS. The component body, by
 * contrast, re-runs on every request — so fetching here is what makes edits show
 * up on refresh. The build still uses the prop, keeping it to one request total.
 *
 * The route *list* is still cached, so a newly created page 404s until the dev
 * server restarts. Fixing that needs an adapter; see web/CLAUDE.md.
 */
let page = import.meta.env.DEV ? undefined : Astro.props.page;
if (!page) {
  const pages = await fetchPages();
  page = pages.find((candidate) => candidate.slug === Astro.params.slug);
}
if (!page) {
  return new Response(null, { status: 404, statusText: "Page not found" });
}
// Unlike events, no truncation is needed here: lib/pages.ts already resolves
// meta.description, falling back to the first prose block and cutting it on a word
// boundary. The remaining fallback is for a page built entirely from images.
const metaDescription =
  page.meta.description || `${page.title} — 2027 CCA Commencement`;
---

<Layout
  title={`${page.meta.title} - 2027 CCA Commencement`}
  description={metaDescription}
>
  <BlockRenderer blocks={page.layout} />
</Layout>
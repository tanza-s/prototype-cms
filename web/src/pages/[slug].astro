---
import type { Page } from "../types/payload";
import Layout from "../layouts/Layout.astro";
import { fetchPages } from "../lib/pages";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";


// Deliberately no `export const prerender` — the route inherits it from `output`, so
// it is prerendered by the build and on demand in dev. Adding the literal here pins
// it to one mode: `true` brings back the cached-route-list 404s on newly created
// pages, `false` stops the build prerendering it. See astro.config.mjs.

// Build only; in dev the route is on demand and this never runs.
export async function getStaticPaths() {
  const pages = await fetchPages();
  return pages.map((page) => ({
    params: { slug: page.slug },
    // Pass the page through so the build doesn't refetch the collection per page.
    props: { page },
  }));
}

interface Props {
  /** Supplied by getStaticPaths, which only runs in production builds. */
  page?: Page;
}

// In dev there is no getStaticPaths and therefore no prop, so this always refetches.
// The build passes the prop through, keeping production to one request total.
let page = Astro.props.page;
if (!page) {
  const pages = await fetchPages();
  page = pages.find((candidate) => candidate.slug === Astro.params.slug);
}
if (!page) {
  return new Response(null, { status: 404, statusText: "Page not found" });
}
// lib/pages.ts already resolves and truncates meta.description; this fallback is
// for a page built entirely from images.
const metaDescription =
  page.meta.description || `${page.title} — 2027 CCA Commencement`;
---

<Layout
  title={`${page.meta.title} - 2027 CCA Commencement`}
  description={metaDescription}
>
  <BlockRenderer blocks={page.layout} />
</Layout>
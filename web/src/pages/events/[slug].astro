---
import type { Event } from '../../types/payload'
import Layout from '../../layouts/Layout.astro'
import { fetchEvents } from '../../lib/api'
import { formatEventRangeLong, toDateTimeAttr } from '../../lib/dates'
import { truncateAtWord } from '../../lib/richtext'

export async function getStaticPaths() {
  const events = await fetchEvents()
  return events.map((event) => ({
    params: { slug: event.slug },
    // Pass the event through so the page doesn't refetch the whole collection.
    props: { event },
  }))
}

interface Props {
  event: Event
}

const { event } = Astro.props

const dateRange = formatEventRangeLong(event.startDate, event.endDate)
const metaDescription = event.excerpt
  ? truncateAtWord(event.excerpt, 155)
  : `${event.title} — 2027 CCA Commencement`
---

<Layout title={`${event.title} - 2027 CCA Commencement`} description={metaDescription}>
  <article class="event">
    {
      event.image && (
        <div class="event__hero">
          <img src={event.image.url} alt={event.image.alt} />
        </div>
      )
    }

    <div class="container-narrow event__body">
      <a href="/" class="event__back">&larr; All events</a>

      <p class="section-label">Commencement Event</p>
      <h1 class="event__title">{event.title}</h1>

      <dl class="event__meta">
        <div class="event__meta-item">
          <dt>Date &amp; Time</dt>
          <dd>
            <time class="u-mono" datetime={toDateTimeAttr(event.startDate)}>{dateRange}</time>
          </dd>
        </div>

        <div class="event__meta-item">
          <dt>Location</dt>
          <dd>{event.location}</dd>
        </div>
      </dl>

      {
        event.rsvpLink && (
          <a
            href={event.rsvpLink}
            target="_blank"
            rel="noopener noreferrer"
            class="button event__rsvp"
          >
            RSVP Now
          </a>
        )
      }

      <hr class="section-divider" />

      <div class="prose event__description" set:html={event.description} />
    </div>
  </article>
</Layout>

<style>
  .event {
    padding-block-end: var(--space-16);
  }

  .event__hero {
    aspect-ratio: 21 / 9;
    max-height: 520px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .event__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event__body {
    padding-block-start: var(--space-12);
  }

  .event__back {
    display: inline-block;
    margin-block-end: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .event__back:hover {
    color: var(--color-accent);
  }

  .event__title {
    margin-block: var(--space-2) var(--space-10);
  }

  .event__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-8);
    margin: 0;
  }

  .event__meta dt {
    margin-block-end: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .event__meta dd {
    margin: 0;
    color: var(--color-text);
  }

  .event__rsvp {
    margin-block-start: var(--space-8);
  }

  .event__description {
    font-size: var(--text-base);
  }
</style>

---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Not Found - 2027 CCA Commencement"
  description="The page you're looking for doesn't exist."
>
  <div class="container not-found">
    <p class="section-label">404</p>
    <h1 class="not-found__title">Page not found</h1>
    <p class="not-found__text u-muted">
      Sorry, we couldn't find the page you're looking for. It may have been moved or unpublished.
    </p>
    <a href="/" class="button">&larr; Back to Home</a>
  </div>
</Layout>

<style>
  .not-found {
    padding-block: var(--space-24);
    text-align: center;
  }

  .not-found__title {
    margin-block: var(--space-2) var(--space-4);
  }

  .not-found__text {
    max-width: 48ch;
    margin-inline: auto;
    margin-block-end: var(--space-8);
  }
</style>

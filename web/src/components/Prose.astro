---
// CMS rich text, rendered.
//
// Deliberately has no opinion about width, position, or vertical rhythm — the block
// using it owns those. That's what makes it safe to drop into a centered page column
// and into a grid cell without either fighting the other.
//
// set:html is safe because lib/richtext.ts escapes all text and whitelists href
// schemes. The tags it can emit are listed above .prose in styles/global.css; if a
// block ever needs a new one, that rule is where it goes.

interface Props {
  /** HTML string from lexicalToHtml. Renders nothing at all when empty. */
  html: string
  class?: string
}

const { html, class: className } = Astro.props
---

{html && <div class:list={['prose', className]} set:html={html} />}

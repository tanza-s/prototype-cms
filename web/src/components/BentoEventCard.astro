---
/**
 * BentoEventCard — the tile used inside BentoEvents.
 *
 * A sibling to EventCard rather than a variant of it: the bento tile has its own
 * anatomy (accent bar, past badge, clamped copy, type that scales with the tile)
 * and folding that into EventCard's horizontal/stacked logic would tangle both.
 * EventCard stays the list-view card.
 */
import type { BentoSize } from '../lib/bento'
import type { Event } from '../types/payload'
import { formatEventSchedule, toDateTimeAttr } from '../lib/dates'

interface Props {
  event: Event
  size: BentoSize
  past: boolean
  /** Palette custom property name, e.g. `--color-teal`. */
  accent: string
  class?: string
}

const { event, size, past, accent, class: className } = Astro.props

// Only the tiles with vertical room can show art without squashing it.
const showsImage = (size === 'large' || size === 'tall') && Boolean(event.image)
// 0 drops the description entirely: a 1x1 tile has no room, and a wide tile
// spends its single row on the title/meta line instead.
const clampLines = { large: 4, tall: 3, wide: 0, compact: 0 }[size]
// A wide tile shares one row with its meta, so its title gets the least room.
const titleLines = { large: 3, tall: 4, wide: 2, compact: 3 }[size]

const dateRange = formatEventSchedule(event)
---

<a
  href={`/events/${event.slug}`}
  class:list={['bento-card', `bento-card--${size}`, { 'is-past': past }, className]}
  style={`--card-accent: var(${accent}); --clamp-lines: ${clampLines}; --title-lines: ${titleLines};`}
>
  {
    showsImage && (
      <div class="bento-card__image">
        <img src={event.image!.url} alt={event.image!.alt} loading="lazy" />
      </div>
    )
  }

  <div class="bento-card__content">
    {past && <p class="bento-card__badge">Past event</p>}

    <h3 class="bento-card__title">{event.title}</h3>

    <dl class="bento-card__meta">
      <dt class="sr-only">Date</dt>
      <dd>
        <time class="u-mono bento-card__date" datetime={toDateTimeAttr(event)}>
          {dateRange}
        </time>
      </dd>
      <dt class="sr-only">Location</dt>
      <dd class="bento-card__location">{event.location}</dd>
    </dl>

    {
      clampLines > 0 && (
        <div class="bento-card__description prose" set:html={event.description} />
      )
    }
  </div>
</a>

<style>
  .bento-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: inherit;
    background-color: var(--color-surface);
    background-image: none; /* opt out of the animated link underline */
    border: 1px solid var(--color-border);
    /* The accent bar is the card's edge, so it can't be a pseudo-element that
       overflow:hidden would clip at the rounded corner. */
    border-inline-start: 3px solid var(--card-accent, var(--color-accent));
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-rest);
    transition:
      box-shadow var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo);
  }

  .bento-card:hover {
    border-block-color: var(--color-accent);
    border-inline-end-color: var(--color-accent);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  /* Past events stay legible but recede, so upcoming events read first. */
  .bento-card.is-past {
    opacity: 0.72;
  }

  .bento-card.is-past:hover {
    opacity: 1;
  }

  /* A fixed aspect ratio is load-bearing, not decoration: without it a portrait
     upload expands to its intrinsic height and drags the whole grid row with it.
     `flex: none` keeps the ratio authoritative and lets __content absorb any
     slack when a neighbouring tile makes the row taller. */
  .bento-card__image {
    flex: none;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-block-end: 1px solid var(--color-border);
  }

  .bento-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Event art is mostly posters, which carry their title at the top — a
       centred crop of a portrait poster into a landscape tile loses exactly the
       part worth showing. */
    object-position: center top;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .bento-card:hover .bento-card__image img {
    transform: scale(1.03);
  }

  .bento-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .bento-card__badge {
    align-self: flex-start;
    margin: 0;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    background-color: color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: var(--radius-sm);
  }

  .bento-card__title {
    /* Set per size below; this is the compact baseline. */
    font-size: var(--text-lg);
    text-wrap: balance;
    color: var(--color-text);
    /* Titles come from editors and can run long ("DMBA Venture Studio Showcase:
       Five Ventures. One Belief. …"). Unclamped, one of those crowds every other
       element out of its tile. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--title-lines, 3);
    line-clamp: var(--title-lines, 3);
    overflow: hidden;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .bento-card:hover .bento-card__title {
    color: var(--color-accent);
  }

  .bento-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-sm);
  }

  .bento-card__meta dd {
    margin: 0;
  }

  .bento-card__date {
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .bento-card__location {
    color: var(--color-text-muted);
  }

  .bento-card__description {
    font-size: var(--text-sm);
    /* -webkit-line-clamp is still the only cross-browser multi-line clamp. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--clamp-lines, 2);
    line-clamp: var(--clamp-lines, 2);
    overflow: hidden;
  }

  .bento-card__description :global(p) {
    max-width: none;
  }

  /* ------------------------------------------------------- size type ramp
     A 2x2 tile with 1x1 type reads as a rendering bug, so the type scales with
     the footprint. Only applies from 1024px up, where the spans are honoured —
     below that every tile is full width and the ramp would just be shouting. */
  @media (min-width: 1024px) {
    /* The ramp follows tile *width*, not area. `tall` is one column wide — the
       same as `compact` — so it keeps the baseline size and earns its space
       through the image and description instead. Only the 2-column tiles scale
       their type up. */
    .bento-card--large .bento-card__title {
      font-size: var(--text-3xl);
    }

    .bento-card--wide .bento-card__title {
      font-size: var(--text-xl);
    }

    .bento-card--large .bento-card__image {
      aspect-ratio: 16 / 9;
    }

    .bento-card--tall .bento-card__image {
      aspect-ratio: 4 / 3;
    }

    .bento-card--large .bento-card__content,
    .bento-card--tall .bento-card__content {
      padding: var(--space-6);
    }

    /* A wide tile has width to spare but only one row of height, so the copy
       runs alongside the meta rather than stacking above it and forcing the row
       taller than its neighbours. */
    .bento-card--wide .bento-card__content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-6);
    }

    .bento-card--wide .bento-card__meta {
      flex-shrink: 0;
      text-align: end;
    }

    /* align-self:flex-start pins the badge to the top in a column card; in the
       wide card's row it would hang off the top edge instead. */
    .bento-card--wide .bento-card__badge {
      align-self: center;
    }
  }
</style>

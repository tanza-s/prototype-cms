---
// Renders an editor's block sequence in order.
//
// Adding a sixth block is: a Block file in cms/src/blocks/, a component here, a
// mapBlock case in lib/pages.ts, a union member in types/payload.ts, and one line
// in COMPONENTS below.

import type { PageBlock } from '../../types/payload'
import CallToAction from './CallToAction.astro'
import Content from './Content.astro'
import Hero from './Hero.astro'
import Image from './Image.astro'
import MediaWithContent from './MediaWithContent.astro'

interface Props {
  blocks: PageBlock[]
}

const { blocks } = Astro.props

/*
 * Typed loosely on purpose. With a precise `as const` map, TS infers `Component` as
 * a union of component functions and then can't prove `block` matches whichever one
 * the lookup selected — indexing doesn't narrow the two in parallel. The key type is
 * still PageBlock['blockType'], so forgetting to add a block here is a compile error;
 * only the props go unchecked.
 */
const COMPONENTS: Record<PageBlock['blockType'], any> = {
  hero: Hero,
  content: Content,
  image: Image,
  mediaWithContent: MediaWithContent,
  callToAction: CallToAction,
}
---

{
  blocks.map((block, i) => {
    const Component = COMPONENTS[block.blockType]
    // Runtime guard for a block type the CMS knows about but this map doesn't yet.
    if (!Component) return null

    return <Component block={block} class:list={['reveal', `stagger-${(i % 8) + 1}`]} />
  })
}

---
// Renders an editor's block sequence in order.
//
// Adding a block: a Block file in cms/src/blocks/ registered in collections/Pages.ts,
// a component here, a mapBlock case in lib/pages.ts, a union member in
// types/payload.ts, and one line in COMPONENTS below. If it carries prose, also give
// deriveDescription in lib/pages.ts a case so the page can fall back to it for meta.

import type { PageBlock } from '../../types/payload'
import CallToAction from './CallToAction.astro'
import Content from './Content.astro'
import Embed from './Embed.astro'
import Gallery from './Gallery.astro'
import Hero from './Hero.astro'
import Image from './Image.astro'
import MediaWithContent from './MediaWithContent.astro'

interface Props {
  blocks: PageBlock[]
}

const { blocks } = Astro.props

/*
 * Values typed `any` on purpose: with a precise map TS can't prove `block` matches
 * whichever component the lookup selected. The KEY type still catches a missing
 * block at compile time — but not a wrong import, so check what you're importing.
 */
const COMPONENTS: Record<PageBlock['blockType'], any> = {
  hero: Hero,
  content: Content,
  image: Image,
  mediaWithContent: MediaWithContent,
  callToAction: CallToAction,
  embed: Embed,
  gallery: Gallery,
}
---

{
  blocks.map((block, i) => {
    const Component = COMPONENTS[block.blockType]
    // Runtime guard for a block type the CMS knows about but this map doesn't yet.
    if (!Component) return null

    return <Component block={block} class:list={['reveal', `stagger-${(i % 8) + 1}`]} />
  })
}

---
// The workhorse block: rich text at one of three measures.
//
// Owns only its width and vertical rhythm; Prose owns how the text itself looks.

import type { ContentBlock } from '../../types/payload'
import Prose from '../Prose.astro'

interface Props {
  block: ContentBlock
  /** Forwarded from the parent so reveal/stagger classes land on the root. */
  class?: string
}

const { block, class: className } = Astro.props
---

{
  block.content && (
    <section class:list={['content-block', `content-block--${block.style}`, className]}>
      <Prose html={block.content} />
    </section>
  )
}

<style>
  /*
   * The width variants set a custom property that one rule consumes, rather than
   * each modifier restating max-width. Adding a fourth measure is then one line,
   * and the padding/centering can't drift between variants.
   */
  .content-block {
    max-width: var(--content-measure);
    margin-inline: auto;
    padding-block: var(--space-12);
    padding-inline: var(--grid-gutter);
  }

  /* Prose wants a readable measure, so this is the default an editor should reach for. */
  .content-block--narrow {
    --content-measure: var(--container-narrow);
  }

  .content-block--wide {
    --content-measure: var(--container-max);
  }

  /*
   * Full keeps the gutter. Text running to a 1600px viewport edge is unreadable,
   * so "full bleed" here means unbounded, not unpadded — the blocks that genuinely
   * touch the edge are the image ones.
   */
  .content-block--full {
    --content-measure: none;
  }
</style>

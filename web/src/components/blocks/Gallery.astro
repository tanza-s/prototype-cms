---
// A reorderable set of images as a grid, opening into a slideshow.
//
// The <dialog> is a sibling of the revealed wrapper, not a child: .reveal.is-visible
// leaves a transform on the element, which would make it the containing block for a
// modal dialog and trap the lightbox inside the section.

import type { GalleryBlock, GalleryColumns } from '../../types/payload'
import ArrowSimple from '../arrows/ArrowSimple.astro'
import XIcon from '../close/XIcon.astro'
import Prose from '../Prose.astro'

interface Props {
  block: GalleryBlock
  /** Forwarded from the parent — see the note above about where it lands. */
  class?: string
}

const { block, class: className } = Astro.props

/**
 * Tile width per column count, mirroring the CSS below: the 1400px container split
 * n ways above the breakpoint, half the viewport below it (the grid is always 2-up
 * on mobile). Overstating these is how srcset stops saving anything.
 */
const TILE_SIZES: Record<GalleryColumns, string> = {
  '2': '(min-width: 768px) 700px, 50vw',
  '3': '(min-width: 768px) 460px, 50vw',
  '4': '(min-width: 768px) 350px, 50vw',
}

/** The featured tile spans every column, so it's the full container either way. */
const FEATURE_SIZES = '(min-width: 768px) 1400px, 100vw'

const tileSizes = TILE_SIZES[block.columns]
const opens = block.enableSlideshow
---

<section
  class:list={[
    'gallery-block',
    `gallery-block--cols-${block.columns}`,
    `gallery-block--${block.tileShape}`,
    { 'gallery-block--feature': block.featureFirst },
  ]}
  data-gallery={opens ? '' : undefined}
>
  <div class:list={['gallery-block__inner', className]}>
    {block.title && <h2 class="gallery-block__title">{block.title}</h2>}
    <Prose html={block.description} />

    <ul class="gallery-block__grid">
      {block.images.map((item, i) => {
        const sizes = block.featureFirst && i === 0 ? FEATURE_SIZES : tileSizes
        const img = (
          <img
            src={item.image.url}
            srcset={item.image.srcset || undefined}
            sizes={item.image.srcset ? sizes : undefined}
            width={item.image.width ?? undefined}
            height={item.image.height ?? undefined}
            alt={item.image.alt}
            loading="lazy"
          />
        )

        return (
          <li class="gallery-block__item">
            <figure class="gallery-block__figure">
              {opens ? (
                <a class="gallery-block__link" href={item.image.url} data-gallery-open>
                  {img}
                </a>
              ) : (
                img
              )}
              {block.showCaptionsInGrid && item.caption && (
                <figcaption class="gallery-block__caption" set:html={item.caption} />
              )}
            </figure>
          </li>
        )
      })}
    </ul>
  </div>

  {opens && (
    <dialog class="gallery-block__dialog" data-gallery-dialog aria-label={block.title ?? 'Gallery'}>
      <div class="gallery-block__viewer" data-gallery-viewer>
        <button
          type="button"
          class="gallery-block__control gallery-block__control--close"
          data-gallery-close
          aria-label="Close gallery"
        >
          <XIcon class="gallery-block__close" />
        </button>

        <button
          type="button"
          class="gallery-block__control gallery-block__control--prev"
          data-gallery-prev
          aria-label="Previous image"
        >
          <ArrowSimple class="gallery-block__arrow gallery-block__arrow--prev" />
        </button>

        <div class="gallery-block__stage">
          {block.images.map((item, i) => (
            <figure class="gallery-block__slide" data-gallery-slide hidden={i !== 0}>
              <img
                src={item.image.url}
                srcset={item.image.srcset || undefined}
                sizes={item.image.srcset ? '90vw' : undefined}
                width={item.image.width ?? undefined}
                height={item.image.height ?? undefined}
                alt={item.image.alt}
                loading="lazy"
              />
              {item.caption && (
                <figcaption class="gallery-block__slide-caption" set:html={item.caption} />
              )}
            </figure>
          ))}
        </div>

        <button
          type="button"
          class="gallery-block__control gallery-block__control--next"
          data-gallery-next
          aria-label="Next image"
        >
          <ArrowSimple class="gallery-block__arrow gallery-block__arrow--next" />
        </button>

        <p class="gallery-block__counter" data-gallery-counter aria-live="polite">
          1 / {block.images.length}
        </p>
      </div>
    </dialog>
  )}
</section>

<style>
  .gallery-block {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-block: var(--space-12);
    padding-inline: var(--grid-gutter);
  }

  .gallery-block__title { margin: 0 0 var(--space-4); }

  .gallery-block__grid {
    display: grid;
    /* Always 2-up on mobile, whatever the editor chose — see TILE_SIZES. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: start; /* keeps "natural" tiles from stretching to the row height */
    margin-block-start: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .gallery-block__figure {
    margin: 0;
    overflow: hidden; /* clips the hover scale-up */
  }

  .gallery-block__link {
    display: block;
    background-image: none; /* opt out of the global animated link underline */
  }

  .gallery-block__item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--gallery-aspect, auto);
    object-fit: cover;
    border-radius: 2px;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .gallery-block__link:hover img { transform: scale(1.04); }

  /* "natural" is `auto`, which makes object-fit a no-op. */
  .gallery-block--landscape { --gallery-aspect: 4 / 3; }
  .gallery-block--square    { --gallery-aspect: 1; }
  .gallery-block--portrait  { --gallery-aspect: 3 / 4; }
  .gallery-block--natural   { --gallery-aspect: auto; }

  .gallery-block--cols-2 { --gallery-columns: 2; }
  .gallery-block--cols-3 { --gallery-columns: 3; }
  .gallery-block--cols-4 { --gallery-columns: 4; }

  .gallery-block--feature .gallery-block__item:first-child { grid-column: 1 / -1; }

  /* A full-width tile wants widescreen — but not in "natural", where the editor
     asked for no cropping. */
  .gallery-block--feature:not(.gallery-block--natural) .gallery-block__item:first-child {
    --gallery-aspect: 16 / 9;
  }

  /* set:html content carries no scope attribute, hence :global(). */
  .gallery-block__caption {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .gallery-block__caption :global(p) { margin: 0; }
  .gallery-block__caption :global(p + p) { margin-block-start: var(--space-2); }

  @media (min-width: 768px) {
    .gallery-block__grid {
      grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-block__item img { transition: none; }
    .gallery-block__link:hover img { transform: none; }
    :global(.gallery-block__arrow) { transition: none; }
  }

  /* -------------------------------------------------------------- slideshow */

  .gallery-block__dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .gallery-block__dialog::backdrop {
    background: rgb(0 0 0 / 0.92);
  }

  .gallery-block__viewer {
    position: relative; /* anchors the close button */
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
  }

  .gallery-block__stage {
    justify-self: center;
    max-width: 90vw;
  }

  .gallery-block__slide { margin: 0; }

  .gallery-block__slide img {
    display: block;
    max-width: 100%;
    /* Room for the caption and the counter below. */
    max-height: 78dvh;
    width: auto;
    height: auto;
    margin-inline: auto;
  }

  .gallery-block__slide-caption {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-on-dark);
  }

  .gallery-block__slide-caption :global(p) { margin: 0; }
  .gallery-block__slide-caption :global(a) { color: var(--color-accent); }

  .gallery-block__control {
    background: none;
    border: 0;
    color: var(--color-on-dark);
    font-size: var(--text-3xl);
    line-height: 1;
    padding: var(--space-3);
    cursor: pointer;
  }

  .gallery-block__control:hover { color: var(--color-accent); }

  .gallery-block__control--close {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-end: var(--space-4);
  }

  /* The icons render in their own components' style scope, so a plain selector
     written here compiles to one that matches nothing. */
  :global(.gallery-block__close) {
    display: block;
    width: 0.5em;
    height: 0.5em;
    color: var(--color-on-dark);
  }

  :global(.gallery-block__arrow) {
    display: block;
    width: 0.5em;
    height: auto;
    transition: color 0.3s ease-in;
  }

  :global(.gallery-block__arrow--prev) { rotate: 90deg; }
  :global(.gallery-block__arrow--next) { rotate: 270deg; }

  .gallery-block__counter {
    grid-column: 1 / -1;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-on-dark);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]')
    // No <dialog> support: leave the links alone, so they still open the full image.
    if (!dialog || typeof dialog.showModal !== 'function') return

    const slides = Array.from(dialog.querySelectorAll<HTMLElement>('[data-gallery-slide]'))
    const counter = dialog.querySelector<HTMLElement>('[data-gallery-counter]')
    if (!slides.length) return

    let index = 0

    function show(next: number) {
      index = (next + slides.length) % slides.length
      slides.forEach((slide, i) => {
        slide.hidden = i !== index
      })
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`
    }

    root.querySelectorAll<HTMLAnchorElement>('[data-gallery-open]').forEach((link, i) => {
      // Only claim to open a dialog once one is known to work.
      link.setAttribute('aria-haspopup', 'dialog')
      link.addEventListener('click', (event) => {
        event.preventDefault()
        show(i)
        dialog.showModal()
      })
    })

    dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1))
    dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(index + 1))
    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close())

    // Click-outside-to-close. The viewer covers the dialog, so testing the dialog
    // alone never matches — the empty space around the image belongs to the viewer.
    const viewer = dialog.querySelector('[data-gallery-viewer]')
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === viewer) dialog.close()
    })

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1) }
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1) }
      // Esc is handled natively by showModal().
    })
  })
</script>

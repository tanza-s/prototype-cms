---
// Two columns: media on one side, rich text on the other, side selectable per block.
//
// Media comes FIRST in the DOM and the flip is done visually with `order`. Reordering
// the source instead would put the image after the text for imageAlignment: 'right',
// changing reading and tab order to achieve a purely visual difference. Below the
// breakpoint the columns stack and `order` stops applying, so media leads — which is
// the right reading order for an image that introduces its text.

import type { MediaWithContentBlock } from '../../types/payload'
import Figure from '../Figure.astro'
import Prose from '../Prose.astro'

interface Props {
  block: MediaWithContentBlock
  /** Forwarded from the parent so reveal/stagger classes land on the root. */
  class?: string
}

const { block, class: className } = Astro.props
---

<section
  class:list={[
    'media-with-content',
    `media-with-content--${block.imageAlignment}`,
    { 'media-with-content--no-media': !block.media },
    className,
  ]}
>
  {
    block.media && (
      <Figure
        class="media-with-content__media"
        image={block.media}
        caption={block.caption}
        linkUrl={block.linkUrl}
      />
    )
  }

  <div class="media-with-content__body">
    <Prose html={block.content} />

    {
      block.callToAction.length > 0 && (
        <ul class="media-with-content__links">
          {block.callToAction.map((link) => (
            <li>
              <a
                class="button button--ghost"
                href={link.url}
                rel={
                  /^https?:\/\//i.test(link.url) ? 'noopener noreferrer' : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .media-with-content {
    display: grid;
    gap: var(--space-6);
    max-width: var(--container-max);
    margin-inline: auto;
    padding-block: var(--space-12);
    padding-inline: var(--grid-gutter);
  }

  .media-with-content__body {
    align-self: center;
  }

  .media-with-content__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .media-with-content {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }

    /*
     * The visual flip. DOM order is unchanged — see the note at the top of the file.
     *
     * This moves the BODY to the front rather than the media to the back, which looks
     * like the long way round but is the only version that works: <Figure> renders in
     * its own component's style scope, so a selector written here compiles to
     * `.media-with-content__media[data-astro-cid-<this file>]` and never matches it.
     * `__body` is a plain div this file owns, so it carries the right scope.
     */
    .media-with-content--right .media-with-content__body {
      order: -1;
    }

    /*
     * With no image there's no second column to fill, so a half-width text block
     * would just look broken. Mirrors .event-card--no-image in EventCard.astro.
     */
    .media-with-content--no-media {
      grid-template-columns: minmax(0, var(--container-narrow));
      justify-content: center;
    }
  }
</style>
